<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title) || "Identity" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" type="text/css" media="all" href="/vendor/uswds/css/uswds.css">
    <%# App-owned styles served with digests via Propshaft %>
    <%= stylesheet_link_tag "sign-in" %>
    <%= stylesheet_link_tag "fake" %>
  </head>
  <body>
    <%= yield %>
    <script src="/vendor/uswds/js/uswds.js"></script>
    <%= javascript_include_tag "scope-element" %>
  </body>
</html>
