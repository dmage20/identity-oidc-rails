<footer class="usa-footer" role="contentinfo">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#">Return to top</a>
  </div>
  <div class="usa-footer__primary-section">
    <nav class="usa-footer__nav">
      <ul class="add-list-reset grid-row grid-gap">
        <li class="mobile-lg:grid-col-4 desktop:grid-col-2 usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="#">Our process</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-2 usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="#">Explore</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-2 usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="#">News</a>
        </li>
        <li class="mobile-lg:grid-col-4 desktop:grid-col-2 usa-footer__primary-content">
          <a class="usa-footer__primary-link" href="#">Get help</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <div class="grid-row grid-gap">
        <div class="usa-footer__logo grid-row mobile-lg:grid-col-6 mobile-lg:grid-gap-2">
          <div class="mobile-lg:grid-col-auto">
            <%= image_tag "GitHub-Mark-120px-plus.png", alt: "GitHub Logo", title: "GitHub Logo", width: 60 %>
          </div>
          <div class="mobile-lg:grid-col-auto">
            <p class="usa-footer__logo-heading">
              <a href="https://github.com/18F/identity-oidc-sinatra">Get the Source Code</a>
            </p>
          </div>
        </div>
        <div class="usa-footer__contact-links mobile-lg:grid-col-6">
          <div class="usa-footer__social-links grid-row grid-gap-1">
            <div class="grid-col-auto">
              <a class="usa-social-link" href="#">
                <img src="/vendor/uswds/img/usa-icons/facebook.svg" alt="Facebook" class="usa-social-link__icon">
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href="#">
                <img src="/vendor/uswds/img/usa-icons/twitter.svg" alt="Twitter" class="usa-social-link__icon">
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href="#">
                <img src="/vendor/uswds/img/usa-icons/youtube.svg" alt="YouTube" class="usa-social-link__icon">
              </a>
            </div>
            <div class="grid-col-auto">
              <a class="usa-social-link" href="#">
                <img src="/vendor/uswds/img/usa-icons/rss_feed.svg" alt="RSS" class="usa-social-link__icon">
              </a>
            </div>
          </div>
          <h3 class="usa-footer__contact-heading">Agency Contact Center</h3>
          <address class="usa-footer__address">
            <div class="usa-footer__contact-info grid-row grid-gap">
              <div class="grid-col-auto">
                <a href="tel:1-800-555-5555">(800) CALL-GOVT</a>
              </div>
              <div class="grid-col-auto">
                <a href="mailto:info@agency.gov">info@agency.gov</a>
              </div>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>
</footer>
