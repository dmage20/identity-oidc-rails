<%= render "shared/banner" %>
<%= render "shared/header",
  logout_msg: @logout_msg,
  login_msg: @login_msg,
  user_email: @user_email,
  access_denied: @access_denied,
  aal: @aal,
  ial: @ial %>

<script type="application/json" id="america-gov-config">
  <%= @america_gov_config.to_json.html_safe %>
</script>

<main id="main-content">
  <% if @pending_dpop_code || @user_sub %>
    <section class="usa-section agov-portal">
      <div class="grid-container">
        <div class="margin-bottom-3">
          <span class="usa-tag bg-primary-dark">America.gov Mock Portal</span>
          <h1 class="font-heading-xl margin-top-1 margin-bottom-1">
            Encrypted Benefits &amp; Fraud Support Workspace
          </h1>
          <p class="usa-intro margin-top-0 margin-bottom-2">
            Messages, client-side widgets, and case tickets below are encrypted and decrypted exclusively in your browser using your Login.gov Site Key.
          </p>
        </div>

        <div id="agov-status-banner" class="usa-alert usa-alert--info margin-bottom-2">
          <div class="usa-alert__body">
            <p id="agov-status-text" class="usa-alert__text">Initializing WebCrypto workspace...</p>
          </div>
        </div>

        <% if @user_sub %>
          <div class="grid-row grid-gap">
            <!-- Left Column: User-Visible Plaintext in Browser -->
            <div class="tablet:grid-col-7">
              <div class="usa-card margin-bottom-3">
                <div class="usa-card__container">
                  <div class="usa-card__header">
                    <h2 class="usa-card__heading">Encrypted Chat History (Decrypted Locally)</h2>
                  </div>
                  <div class="usa-card__body">
                    <div id="agov-chat-log" class="agov-chat-log margin-bottom-2">
                      Loading encrypted conversations...
                    </div>

                    <form id="agov-chat-form" class="usa-form maxw-none">
                      <label class="usa-label margin-top-0" for="agov-chat-input">
                        Send a message (encrypted in browser before POST)
                      </label>
                      <div class="display-flex flex-align-end grid-gap-1">
                        <input id="agov-chat-input" type="text" class="usa-input flex-1 margin-top-0"
                               placeholder="Ask about SSA benefits or report suspicious activity..." required>
                        <button type="submit" class="usa-button margin-top-0">Encrypt &amp; Send</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

              <div class="usa-card">
                <div class="usa-card__container">
                  <div class="usa-card__header">
                    <h2 class="usa-card__heading">Client-Side Only Interaction Widget</h2>
                  </div>
                  <div class="usa-card__body">
                    <p class="font-sans-xs text-base margin-top-0">
                      Simulates browser-only UI widgets or 3rd-party API responses that never pass through America.gov’s server in plaintext.
                    </p>
                    <form id="agov-widget-form" class="usa-form maxw-none">
                      <div class="grid-row grid-gap">
                        <div class="tablet:grid-col-7">
                          <label class="usa-label margin-top-0" for="agov-widget-category">Interaction Type</label>
                          <select id="agov-widget-category" class="usa-select">
                            <option value="Fraud Report Intake">Fraud Report Intake</option>
                            <option value="SSA Benefit Estimate">SSA Benefit Estimate</option>
                            <option value="3rd-Party API Summary">3rd-Party API Case Summary</option>
                          </select>
                        </div>
                        <div class="tablet:grid-col-5">
                          <label class="usa-label margin-top-0" for="agov-widget-amount">Est. Amount ($)</label>
                          <input id="agov-widget-amount" type="number" class="usa-input" value="1850">
                        </div>
                      </div>
                      <label class="usa-label" for="agov-widget-details">Sensitive Details (Browser-Only)</label>
                      <textarea id="agov-widget-details" class="usa-textarea" rows="2"
                                placeholder="e.g., Claim #4821 — unauthorized deposit inquiry..." required></textarea>
                      <div class="margin-top-2 display-flex flex-wrap grid-gap-1">
                        <button type="submit" class="usa-button">Save Encrypted Widget Ticket</button>
                        <button type="button" id="agov-server-seal-btn" class="usa-button usa-button--outline">
                          Simulate Offline Server-Sealed Ticket
                        </button>
                        <button type="button" id="agov-clear-btn" class="usa-button usa-button--secondary">
                          Clear Stored History
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column: Zero-Knowledge Proof & Server Storage Inspector -->
            <div class="tablet:grid-col-5">
              <div class="usa-card margin-bottom-3">
                <div class="usa-card__container">
                  <div class="usa-card__header">
                    <h2 class="usa-card__heading">Key Custody Telemetry</h2>
                  </div>
                  <div class="usa-card__body font-sans-xs">
                    <div class="margin-bottom-105">
                      <strong>Browser State:</strong>
                      <div id="agov-key-state" class="text-green text-bold">—</div>
                    </div>
                    <div class="margin-bottom-105">
                      <strong>DPoP Key Thumbprint (<code>dpop_jkt</code>):</strong>
                      <div id="agov-dpop-jkt" class="agov-mono">—</div>
                    </div>
                    <div>
                      <strong>Site Key Public JWK (<code>site_key_public</code>):</strong>
                      <div id="agov-site-key-pub" class="agov-mono">—</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="usa-card">
                <div class="usa-card__container">
                  <div class="usa-card__header">
                    <h2 class="usa-card__heading">What America.gov’s Server Sees (JSON Store)</h2>
                  </div>
                  <div class="usa-card__body">
                    <p class="font-sans-xs text-base margin-top-0">
                      Live contents of <code>tmp/america_gov_conversations.json</code> for your <code>sub</code>. Zero plaintext exists on disk.
                    </p>
                    <pre id="agov-raw-json" class="agov-cipher-pre">[]</pre>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="usa-hero">
    <div class="grid-container">
      <div class="usa-hero__callout">
        <% if @user_email %>
          <h1 class="usa-hero__heading">
            <span class="usa-hero__heading--alt">Welcome Back!</span>
            You are logged in
          </h1>
          <p>Open a second Incognito browser window and sign in to test cross-device decryption under a fresh DPoP key.</p>
        <% else %>
          <h1 class="usa-hero__heading">
            <span class="usa-hero__heading--alt">America.gov + Login.gov</span>
            Zero-Knowledge Site Key Demo
          </h1>
          <p>Click <strong>Sign in</strong> above with <code>site_key</code> checked (default for IAL1) to test end-to-end key custody, recovery codes, and browser-side encryption.</p>
        <% end %>
      </div>
    </div>
    <% if @userinfo %>
      <div class="userinfo">
        <div class="padding-2 clearfix bg-white fg-black">
          Received user info:<br>
          <div>
            <ul>
              <% @userinfo.each_pair do |key, val| %>
                <% val = maybe_redact_ssn(val) if key.to_s == 'social_security_number' %>
                <li>
                  <pre><%= key.inspect %>: <%= val.inspect %></pre>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
  </section>

  <section class="grid-container usa-section">
    <div class="grid-row grid-gap">
      <div class="tablet:grid-col-4">
        <h2 class="font-heading-xl margin-top-0 tablet:margin-bottom-0">How this mock tests your 4-PR stack</h2>
      </div>
      <div class="tablet:grid-col-8 usa-prose">
        <p>
          When you click <strong>Sign in</strong>, your browser generates an ephemeral P-256 DPoP keypair in <code>sessionStorage</code>, sends its thumbprint (<code>dpop_jkt</code>) to Login.gov, unseals the <code>site_key</code> JWE delivered at <code>/userinfo</code>, and encrypts/decrypts your chat history locally via WebCrypto.
        </p>
      </div>
    </div>
  </section>
</main>
<%= render "shared/footer" %>
